# ─── صلي هذه المتغيرات في Vercel → Settings → Environment Variables ───

# قاعدة البيانات (Postgres) — مطلوبة فقط وقت التشغيل، مو البناء
# من Neon / Supabase / Railway / Vercel Postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# PIN لوحة التحكم /admin (اختياري — الافتراضي 1234)
ADMIN_PIN=1234

# بوابة Stripe (اختياري — لما تربطين الدفع الإلكتروني)
# NEXT_PUBLIC_STRIPE_PK=pk_test_...
# STRIPE_SK=sk_test_...
